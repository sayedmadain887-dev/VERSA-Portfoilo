# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas free tier connection string, or your local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/versa

# Long random strings - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# The one and only admin account is created via the seed script, not public registration
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change_this_before_seeding

# Frontend origin allowed to call this API
CLIENT_ORIGIN=http://localhost:3000
