40:["$","$L41",null,{"locale":"ar","now":"$D2026-08-10T01:39:14.074Z","timeZone":"Africa/Cairo","messages":{"meta":{"title":"VERSA — مهندس Full Stack","description":"مطوّر Full Stack يبني منتجات ويب سريعة وآمنة وجاهزة للإنتاج."},"nav":{"home":"الرئيسية","about":"نبذة عني","skills":"المهارات","services":"الخدمات","projects":"المشاريع","testimonials":"آراء العملاء","contact":"تواصل"},"hero":{"eyebrow":"متاح للعمل — استجابة خلال 24 ساعة","titleLine1":"نبني منتجات","titleLine2Accent":"رقمية","titleLine2Rest":"تتحمّل","titleLine3":"الضغط الحقيقي","typing":["مهندس Full Stack","متخصص React و Next.js","مطوّر Node.js و MongoDB","أُعطي الأمان أولوية دائمًا"],"subtitle":"مهندس Full Stack متخصص في بناء أنظمة كاملة من الواجهة حتى قاعدة البيانات — أداء عالٍ، أمان صارم، وتجربة استخدام لا تُنسى.","ctaPrimary":"اطّلع على المشاريع","ctaSecondary":"احجز مكالمة","stats":{"projects":"مشروع منجَز","satisfaction":"% رضا العملاء","years":"سنوات خبرة"},"scroll":"مرّر للأسفل"},"skills":{"eyebrow":"/// القدرات التقنية","titleLine1":"أدوات أتقنها","titleLine2":"وأثق بها","desc":"مجموعة تقنية مختارة بعناية تغطي كامل دورة حياة المنتج الرقمي، من التصميم إلى النشر والمراقبة.","items":[{"title":"Frontend","desc":"React · Next.js · TypeScript · Tailwind"},{"title":"Backend","desc":"Node.js · Express · REST · GraphQL"},{"title":"قواعد البيانات","desc":"MongoDB · PostgreSQL · Redis"},{"title":"DevOps","desc":"Docker · CI/CD · AWS · Nginx"},{"title":"UI/UX","desc":"Figma · Motion Design · Design Systems"},{"title":"الأمان","desc":"JWT · OWASP · Rate Limiting · RBAC"},{"title":"الاختبار","desc":"Jest · Cypress · Playwright"},{"title":"الأداء","desc":"Lighthouse 95+ · Lazy Load · Caching"}]},"testimonials":{"eyebrow":"/// آراء العملاء","titleLine1":"ثقة حقيقية من","titleLine2":"عملاء حقيقيين","items":[{"text":"تعامل احترافي جدًا، التزام بالمواعيد، والنتيجة فاقت التوقعات بمراحل.","name":"أحمد م.","role":"مؤسس شركة ناشئة"},{"text":"فهم عميق لاحتياجات المشروع، وتنفيذ نظيف وقابل للتوسع فعليًا.","name":"سارة ع.","role":"مديرة منتج"},{"text":"سرعة في التنفيذ مع جودة كود عالية، تجربة تعامل ممتازة من البداية للنهاية.","name":"خالد م.","role":"CTO"}]},"about":{"eyebrow":"/// نبذة عني","titleLine1":"الشخص اللي","titleLine2":"بيقف وراء الكود","intro":"مهندس Full Stack بخبرة تتجاوز 6 سنوات في تحويل المشاكل المعقدة لمنتجات رقمية سريعة وآمنة وقابلة للصيانة. بيهمني معمار النظام من الخلف بقد ما بيهمني آخر بكسل يشوفه المستخدم.","downloadCV":"تحميل السيرة الذاتية","mission":{"title":"الرسالة","text":"بناء برمجيات تحترم وقت المستخدم، وميزانية العميل، والمطوّر اللي هيقرا الكود بعدي.","value":""},"vision":{"title":"الرؤية","text":"أكون المهندس اللي الفرق بتلجأله لما تكون المشكلة صعبة والديدلاين حقيقي."},"journeyEyebrow":"/// الرحلة","journeyTitle":"الخط الزمني","timeline":[{"year":"2019","title":"بدأت كمطوّر Frontend","desc":"بدأت الرحلة ببناء واجهات باستخدام React، مع تركيز على الأداء وتنظيف الواجهة."},{"year":"2021","title":"انتقلت لأدوار Full Stack","desc":"توسّعت في Node.js وExpress وتصميم قواعد البيانات لأنظمة إنتاجية."},{"year":"2023","title":"قدت مشاريع فريلانس لعملاء عالميين","desc":"سلّمت أكتر من 30 منتج متكامل في التجارة الإلكترونية وSaaS والتكنولوجيا المالية."},{"year":"2025","title":"تخصصت في الأداء والأمان","desc":"ركّزت على المعمار القابل للتوسع، ممارسات OWASP، وسرعات تحميل أقل من ثانية."}],"educationEyebrow":"/// التعليم والشهادات","educationTitle":"المؤهلات","education":[{"title":"بكالوريوس علوم حاسب","org":"جامعة القاهرة","year":"2019"},{"title":"AWS Certified Developer – Associate","org":"Amazon Web Services","year":"2022"},{"title":"Meta Front-End Developer Professional Certificate","org":"Meta","year":"2021"}],"achievementsEyebrow":"/// الإنجازات","achievementsTitle":"أرقام لها معنى","achievements":[{"num":"47","label":"مشروع تم تسليمه"},{"num":"18","label":"عميل طويل المدى"},{"num":"99%","label":"تسليم في الموعد"},{"num":"6","label":"سنوات خبرة"}]},"skillsPage":{"eyebrow":"/// مهارات مطوّر Full Stack","titleLine1":"كل حاجة محتاجها","titleLine2":"عشان تشحن منتج","intro":"بابني تطبيقات ويب حديثة، قابلة للتوسع، وآمنة باستخدام منهج Full Stack متكامل — من أول بكسل لآخر استعلام في قاعدة البيانات.","categories":[{"name":"تطوير الواجهة الأمامية","icon":"layout","items":[{"name":"React.js و Next.js","level":95,"desc":"بناء واجهات مستخدم متجاوبة وتفاعلية."},{"name":"Tailwind CSS و Material UI","level":92,"desc":"تصميمات حديثة ونظام تصميم متسق."},{"name":"Framer Motion و GSAP","level":88,"desc":"حركات سلسة وتجربة مستخدم متقدمة."},{"name":"SEO والأداء","level":90,"desc":"تطبيقات صديقة لمحركات البحث وعالية الأداء."}]},{"name":"تطوير الواجهة الخلفية","icon":"server","items":[{"name":"Node.js و Express.js","level":92,"desc":"APIs آمنة وقابلة للتوسع."},{"name":"المصادقة والصلاحيات","level":88,"desc":"نظام JWT مع صلاحيات حسب الدور."},{"name":"معمار الباك إند","level":85,"desc":"أنظمة قابلة للصيانة وجاهزة للنمو."}]},{"name":"قواعد البيانات وإدارة المعلومات","icon":"database","items":[{"name":"MongoDB و Mongoose","level":90,"desc":"تصميم الـ Schema ونمذجة البيانات."},{"name":"تحسين الاستعلامات","level":83,"desc":"استعلامات فعّالة وسريعة الأداء."},{"name":"PostgreSQL و Redis","level":78,"desc":"بيانات علائقية وطبقات تخزين مؤقت."}]},{"name":"مميزات التطبيقات","icon":"layers","items":[{"name":"منصات تجارة إلكترونية","level":90,"desc":"أنظمة متجر وسلة شراء ودفع كاملة."},{"name":"لوحات تحكم إدارية","level":93,"desc":"لوحات تحكم قوية وغنية بالبيانات."},{"name":"تكاملات خارجية","level":86,"desc":"دفع، خرائط، إيميل، وAPIs خارجية."},{"name":"رفع الملفات والتخزين السحابي","level":84,"desc":"إدارة آمنة للوسائط على نطاق واسع."}]},{"name":"الأمان والاختبار","icon":"shield","items":[{"name":"أفضل ممارسات أمان الويب","level":87,"desc":"معايير OWASP، التحقق من المدخلات، تحديد المعدل."},{"name":"حماية الـ API والبيانات","level":85,"desc":"تشفير، تنظيف بيانات، وتحكم في الوصول."},{"name":"الاختبار الآلي","level":78,"desc":"تغطية اختبارات بـ Jest وCypress وPlaywright."}]},{"name":"الأدوات والنشر","icon":"rocket","items":[{"name":"Git و GitHub","level":95,"desc":"ا